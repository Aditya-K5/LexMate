datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  LAWYER
  ASSOCIATE
  STAFF
}

enum CaseStatus {
  ACTIVE
  PENDING
  DISPOSED
  APPEALED
  ARCHIVED
}

enum HearingStatus {
  SCHEDULED
  ADJOURNED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum TimelineEventType {
  HEARING
  FILING
  ORDER
  MEETING
  NOTE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  clients        Client[]
  cases          Case[]
  hearings       Hearing[]
  documents      Document[]
  tasks          Task[]
  payments       Payment[]
  timelineEvents TimelineEvent[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(LAWYER)
  phone          String?
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedCases  Case[]       @relation("AssignedLawyer")
  assignedTasks  Task[]       @relation("AssignedTasks")
  auditLogs      AuditLog[]

  @@index([organizationId])
  @@map("users")
}

model Client {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String
  address        String?
  companyName    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cases        Case[]
  documents    Document[]
  payments     Payment[]

  @@index([organizationId])
  @@map("clients")
}

model Case {
  id               String     @id @default(uuid())
  organizationId   String
  clientId         String
  caseNumber       String
  caseType         String
  court            String
  judge            String?
  status           CaseStatus @default(ACTIVE)
  title            String
  summary          String?
  nextHearingDate  DateTime?
  assignedLawyerId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedLawyer User?           @relation("AssignedLawyer", fields: [assignedLawyerId], references: [id], onDelete: SetNull)
  hearings       Hearing[]
  documents      Document[]
  tasks          Task[]
  payments       Payment[]
  timelineEvents TimelineEvent[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId])
  @@index([clientId])
  @@map("cases")
}

model Hearing {
  id              String        @id @default(uuid())
  organizationId  String
  caseId          String
  title           String
  court           String
  courtroom       String?
  judge           String?
  date            DateTime
  status          HearingStatus @default(SCHEDULED)
  purpose         String?
  outcome         String?
  nextHearingDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([caseId])
  @@index([date])
  @@map("hearings")
}

model Document {
  id             String   @id @default(uuid())
  organizationId String
  caseId         String?
  clientId       String?
  fileName       String
  fileSize       Int
  mimeType       String
  storageKey     String
  category       String?
  summary        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([caseId])
  @@index([clientId])
  @@map("documents")
}

model Task {
  id             String       @id @default(uuid())
  organizationId String
  caseId         String?
  assignedToId   String?
  title          String
  description    String?
  dueDate        DateTime?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo   User?        @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([caseId])
  @@index([assignedToId])
  @@map("tasks")
}

model Payment {
  id             String        @id @default(uuid())
  organizationId String
  clientId       String
  caseId         String?
  amount         Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  dueDate        DateTime?
  paidAt         DateTime?
  invoiceNumber  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([caseId])
  @@map("payments")
}

model TimelineEvent {
  id             String            @id @default(uuid())
  organizationId String
  caseId         String
  title          String
  description    String?
  date           DateTime          @default(now())
  type           TimelineEventType @default(HEARING)
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([caseId])
  @@map("timeline_events")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@map("audit_logs")
}
